{
  "name": "nowwhats",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "deps:check": "depcruise packages apps --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run deps:check && turbo run typecheck lint test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
